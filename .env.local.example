# Lead Search uses the free OpenStreetMap / Overpass API by default — no key needed.
# Optionally point to a different Overpass mirror if the default is rate-limited:
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# Optional: enable Playwright-based deep website checks (slow). Defaults to false.
ENABLE_PLAYWRIGHT=false

# Optional: bias all searches around Malta (lat, lng, radius_meters)
DEFAULT_LAT=35.9375
DEFAULT_LNG=14.3754
DEFAULT_RADIUS=20000
